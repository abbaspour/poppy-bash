# cp env.sample .env

# --- the Personal Agent's identity (section 4.1) ---
# Public HTTPS base where web/public is served, eg. your Cloudflare tunnel hostname.
# client_id becomes ${AGENT_BASE_URL}/cimd.json, and jwks_uri ${AGENT_BASE_URL}/jwks.json.
AGENT_BASE_URL=https://agent.example.dev
AGENT_NAME=poppy-bash

# Client assertion algorithm at token endpoints. Poppy requires Companies to accept ES256 and
# PS384, so ES256 works with any conforming issuer. Use PS256 with an issuer that accepts only RSA
# algorithms, such as a standard Auth0 tenant (RS256, RS384, PS256).
CLIENT_ASSERTION_ALG=ES256

# --- the Company to work with ---
# Optional default for -d; otherwise the last domain passed to discover.sh is used.
COMPANY_DOMAIN=

# --- the User ---
# The local User this agent acts for. Each gets their own User ID at each Company (section 5.1).
POPPY_USER=default

# --- sign-in (section 4) ---
# Resources to name in the request that starts sign-in, comma separated: URLs, or "default" for
# https://{organization.domain}. Leave empty: Poppy says a sign-in names no resource and then
# covers every service (section 4.5). Set "default" only for an issuer that needs a resource to choose the
# token's audience, eg. Auth0 without a default audience (with its Resource Parameter
# Compatibility Profile on).
POPPY_SIGN_IN_RESOURCES=

# --- browser join (section 6) ---
# The agent's own Chrome, which browser-join.sh starts with a profile under .state/ and drives over
# DevTools on this machine. Never point it at the User's own browser.
POPPY_BROWSER_PORT=9222
# Leave empty to use the first Chrome or Chromium found
POPPY_BROWSER=

# --- tunnel (web/Makefile) ---
TUNNEL_ID=
TUNNEL_HOSTNAME=agent.example.dev

# --- oidc-bash, for the OAuth steps (phase 2) ---
OIDC_BASH_DIR=../oidc-bash

# --- local development only ---
# 1 = allow http://localhost URLs for the agent and the Company, eg. against `wrangler dev`.
POPPY_DEV_ALLOW_HTTP=0
